{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario_library_entry.schema.json",
  "title": "CARLA Extreme Scenario Library Entry V1",
  "description": "场景库中的独立参数场景、来源追踪、运行证据、风险结果和质量评估记录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "library_id",
    "scenario_hash",
    "canonical_sample_id",
    "aliases",
    "family",
    "parameters",
    "labels",
    "provenance",
    "execution_evidence",
    "observed_risk",
    "quality"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "library_id": {
      "type": "string",
      "pattern": "^slv1_[a-f0-9]{16}$"
    },
    "scenario_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "canonical_sample_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,127}$"
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "family": {"const": "multi_hazard_parameter_v1"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "weather", "lead_vehicle", "pedestrian"],
      "properties": {
        "duration_seconds": {"type": "number", "minimum": 10.0, "maximum": 60.0},
        "weather": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cloudiness",
            "precipitation",
            "precipitation_deposits",
            "wind_intensity",
            "fog_density",
            "fog_distance",
            "sun_altitude_angle",
            "wetness"
          ],
          "properties": {
            "cloudiness": {"type": "number", "minimum": 0.0, "maximum": 100.0},
            "precipitation": {"type": "number", "minimum": 0.0, "maximum": 100.0},
            "precipitation_deposits": {"type": "number", "minimum": 0.0, "maximum": 100.0},
            "wind_intensity": {"type": "number", "minimum": 0.0, "maximum": 100.0},
            "fog_density": {"type": "number", "minimum": 0.0, "maximum": 100.0},
            "fog_distance": {"type": "number", "minimum": 0.0, "maximum": 1000.0},
            "sun_altitude_angle": {"type": "number", "minimum": -90.0, "maximum": 90.0},
            "wetness": {"type": "number", "minimum": 0.0, "maximum": 100.0}
          }
        },
        "lead_vehicle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initial_distance_m", "brake_trigger_seconds", "brake_intensity"],
          "properties": {
            "initial_distance_m": {"type": "number", "minimum": 12.0, "maximum": 60.0},
            "brake_trigger_seconds": {"type": "number", "minimum": 0.0, "maximum": 60.0},
            "brake_intensity": {"type": "number", "minimum": 0.0, "maximum": 1.0}
          }
        },
        "pedestrian": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "forward_distance_m",
            "roadside_offset_m",
            "spawn_z_offset_m",
            "trigger_seconds",
            "speed_mps"
          ],
          "properties": {
            "forward_distance_m": {"type": "number", "minimum": 15.0, "maximum": 60.0},
            "roadside_offset_m": {"type": "number", "minimum": 3.0, "maximum": 15.0},
            "spawn_z_offset_m": {"type": "number", "minimum": 0.0, "maximum": 2.0},
            "trigger_seconds": {"type": "number", "minimum": 0.0, "maximum": 60.0},
            "speed_mps": {"type": "number", "minimum": 1.0, "maximum": 8.0}
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_risk_levels",
        "observed_risk_level",
        "weather_tags",
        "hazard_tags",
        "generators"
      ],
      "properties": {
        "target_risk_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["low", "medium", "high", "critical"]}
        },
        "observed_risk_level": {
          "enum": ["low", "medium", "high", "critical"]
        },
        "weather_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "hazard_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "generators": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_refs"],
      "properties": {
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "experiment_format",
              "generator",
              "generator_implementation",
              "generator_seed",
              "source_record_path",
              "source_record_sha256",
              "selected_records_path",
              "selected_records_sha256",
              "manifest_path",
              "manifest_sha256",
              "run_results_path",
              "run_results_sha256"
            ],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "experiment_format": {"type": "string", "minLength": 1},
              "generator": {"type": "string", "minLength": 1},
              "generator_implementation": {"type": "string", "minLength": 1},
              "generator_seed": {"type": ["integer", "null"], "minimum": 0},
              "source_record_path": {"type": "string", "minLength": 1},
              "source_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "selected_records_path": {"type": "string", "minLength": 1},
              "selected_records_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "manifest_path": {"type": "string", "minLength": 1},
              "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "run_results_path": {"type": "string", "minLength": 1},
              "run_results_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "execution_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification_level",
        "verification_basis",
        "evidence_granularity",
        "expected_run_count",
        "completed_run_count",
        "accepted_run_count",
        "runtime_verified_run_count",
        "route_verified_run_count",
        "acceptance_rate",
        "traffic_manager_seeds",
        "carla_versions",
        "sensor_statuses",
        "server_statuses",
        "run_ids",
        "metadata_paths",
        "config_refs",
        "aggregate_refs"
      ],
      "properties": {
        "verification_level": {
          "enum": ["static_validated", "runtime_completed", "strictly_accepted"]
        },
        "verification_basis": {
          "enum": ["direct_run_evidence", "inherited_batch_acceptance"]
        },
        "evidence_granularity": {
          "enum": ["run_level", "aggregate"]
        },
        "expected_run_count": {"type": "integer", "minimum": 0},
        "completed_run_count": {"type": "integer", "minimum": 0},
        "accepted_run_count": {"type": "integer", "minimum": 0},
        "runtime_verified_run_count": {"type": "integer", "minimum": 0},
        "route_verified_run_count": {"type": "integer", "minimum": 0},
        "acceptance_rate": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "traffic_manager_seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "carla_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "sensor_statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "server_statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "run_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "metadata_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "config_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["run_id", "path", "sha256"],
            "properties": {
              "run_id": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
            }
          }
        },
        "aggregate_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path", "sha256"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    },
    "observed_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methods",
        "score_mean",
        "score_std",
        "score_min",
        "score_max",
        "modal_level",
        "target_match_rate",
        "high_or_critical",
        "collision_observed",
        "collision_run_count",
        "collision_event_count",
        "minimum_ttc_seconds",
        "minimum_lead_gap_m",
        "minimum_pedestrian_distance_m"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "score_mean": {"type": "number", "minimum": 0.0, "maximum": 100.0},
        "score_std": {"type": "number", "minimum": 0.0},
        "score_min": {"type": "number", "minimum": 0.0, "maximum": 100.0},
        "score_max": {"type": "number", "minimum": 0.0, "maximum": 100.0},
        "modal_level": {"enum": ["low", "medium", "high", "critical"]},
        "target_match_rate": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
        "high_or_critical": {"type": "boolean"},
        "collision_observed": {"type": "boolean"},
        "collision_run_count": {"type": "integer", "minimum": 0},
        "collision_event_count": {"type": "integer", "minimum": 0},
        "minimum_ttc_seconds": {"type": ["number", "null"]},
        "minimum_lead_gap_m": {"type": ["number", "null"]},
        "minimum_pedestrian_distance_m": {"type": ["number", "null"]}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_status",
        "operational_score",
        "tier",
        "executability",
        "evidence_completeness",
        "repeatability",
        "dangerousness",
        "diversity",
        "realism",
        "flags"
      ],
      "properties": {
        "assessment_status": {"enum": ["partial", "complete"]},
        "operational_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "tier": {"enum": ["bronze", "silver", "gold"]},
        "executability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "score"],
          "properties": {
            "status": {"enum": ["assessed", "not_assessed"]},
            "score": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0}
          }
        },
        "evidence_completeness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "score"],
          "properties": {
            "status": {"enum": ["assessed", "not_assessed"]},
            "score": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0}
          }
        },
        "repeatability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "score", "score_std_reference"],
          "properties": {
            "status": {"enum": ["assessed", "not_assessed"]},
            "score": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
            "score_std_reference": {"type": "number", "minimum": 0.0}
          }
        },
        "dangerousness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "score"],
          "properties": {
            "status": {"enum": ["assessed", "not_assessed"]},
            "score": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0}
          }
        },
        "diversity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "score", "nearest_neighbor_distance", "reference_distance"],
          "properties": {
            "status": {"enum": ["assessed", "not_assessed"]},
            "score": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
            "nearest_neighbor_distance": {"type": ["number", "null"], "minimum": 0.0},
            "reference_distance": {"type": "number", "minimum": 0.0}
          }
        },
        "realism": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "score"],
          "properties": {
            "status": {"enum": ["assessed", "not_assessed"]},
            "score": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0}
          }
        },
        "flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
