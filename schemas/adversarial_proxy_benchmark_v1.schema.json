{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adversarial_proxy_benchmark_v1.schema.json",
  "title": "Adversarial Frozen Proxy Benchmark V1 Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "executor_config_path",
    "agent_config_path",
    "baseline_config_path",
    "training",
    "evaluation",
    "output_subdirectory"
  ],
  "properties": {
    "format": {"const": "adversarial_proxy_benchmark_v1"},
    "executor_config_path": {"type": "string", "minLength": 1},
    "agent_config_path": {"type": "string", "minLength": 1},
    "baseline_config_path": {"type": "string", "minLength": 1},
    "training": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithms",
        "seeds",
        "total_timesteps",
        "device",
        "max_excluded_skips"
      ],
      "properties": {
        "algorithms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["ppo", "sac"]}
        },
        "seeds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "total_timesteps": {"type": "integer", "minimum": 64},
        "device": {"type": "string", "minLength": 1},
        "max_excluded_skips": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "sample_seed",
        "deterministic_policy"
      ],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 12},
        "sample_seed": {"type": "integer", "minimum": 0},
        "deterministic_policy": {"type": "boolean"}
      }
    },
    "output_subdirectory": {"type": "string", "minLength": 1}
  }
}
