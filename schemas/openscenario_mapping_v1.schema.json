{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openscenario_mapping_v1.schema.json",
  "title": "Custom Scenario JSON to OpenSCENARIO/CARLA Mapping V1",
  "description": "阶段四第一步的版本化适配边界。该映射只覆盖 OpenSCENARIO XML 1.0 的保守子集，并把 CARLA 专属字段保留在旁路配置中。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mapping_version",
    "adapter_id",
    "source",
    "openscenario",
    "carla",
    "field_mappings",
    "coverage"
  ],
  "properties": {
    "mapping_version": {"const": "1.0"},
    "adapter_id": {"const": "custom_json_to_openscenario_carla_v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_path", "family"],
      "properties": {
        "schema_path": {"type": "string", "minLength": 1},
        "family": {"const": "multi_hazard_parameter_v1"}
      }
    },
    "openscenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standard_version", "road_network_logic_file", "coordinate_system"],
      "properties": {
        "standard_version": {"const": "1.0"},
        "road_network_logic_file": {"type": "string", "minLength": 1},
        "coordinate_system": {"const": "CARLA"},
        "entity_names": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ego", "lead", "pedestrian"],
          "properties": {
            "ego": {"const": "ego"},
            "lead": {"const": "lead_vehicle"},
            "pedestrian": {"const": "pedestrian"}
          }
        }
      }
    },
    "carla": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_config_path", "extension_prefix"],
      "properties": {
        "base_config_path": {"type": "string", "minLength": 1},
        "extension_prefix": {"const": "carla:"},
        "compiled_output_suffix": {"const": ".carla.json"}
      }
    },
    "field_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "mode"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "mode": {"enum": ["direct", "preserved", "inherited", "unsupported"]},
          "note": {"type": "string"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct", "preserved_out_of_band", "not_executable_in_xosc_v1"],
      "properties": {
        "direct": {"type": "array", "items": {"type": "string"}},
        "preserved_out_of_band": {"type": "array", "items": {"type": "string"}},
        "not_executable_in_xosc_v1": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
