{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adversarial_proxy_executor_v1.schema.json",
  "title": "Adversarial Frozen Risk Proxy Executor V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "executor_id",
    "model",
    "feature_contract",
    "training_evidence",
    "prediction",
    "reward_channels_available"
  ],
  "properties": {
    "format": {"const": "adversarial_proxy_executor_v1"},
    "executor_id": {"const": "risk_proxy_v5_physical"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_env", "relative_path", "sha256", "class"],
      "properties": {
        "root_env": {"type": "string", "minLength": 1},
        "relative_path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "class": {"type": "string", "minLength": 1}
      }
    },
    "feature_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_space",
        "physical_feature_version",
        "baseline_feature_count",
        "derived_feature_count",
        "feature_count",
        "feature_names"
      ],
      "properties": {
        "feature_space": {"const": "physical_enhanced"},
        "physical_feature_version": {"const": "physical_interaction_v1"},
        "baseline_feature_count": {"const": 15},
        "derived_feature_count": {"const": 12},
        "feature_count": {"const": 27},
        "feature_names": {
          "type": "array",
          "minItems": 27,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "training_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "dataset_sha256",
        "independent_scenario_count",
        "target_column",
        "target_risk_level_used_as_input",
        "generator_used_as_input",
        "selected_model_metrics"
      ],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "dataset_sha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "independent_scenario_count": {"const": 117},
        "target_column": {"const": "observed_risk_score_mean"},
        "target_risk_level_used_as_input": {"const": false},
        "generator_used_as_input": {"const": false},
        "selected_model_metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mae", "rmse", "spearman", "high_or_critical_recall"],
          "properties": {
            "mae": {"type": "number", "minimum": 0.0},
            "rmse": {"type": "number", "minimum": 0.0},
            "spearman": {"type": "number", "minimum": -1.0, "maximum": 1.0},
            "high_or_critical_recall": {"type": "number", "minimum": 0.0, "maximum": 1.0}
          }
        }
      }
    },
    "prediction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_score", "maximum_score", "levels"],
      "properties": {
        "minimum_score": {"const": 0.0},
        "maximum_score": {"const": 100.0},
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["medium", "high", "critical"],
          "properties": {
            "medium": {"const": 25.0},
            "high": {"const": 50.0},
            "critical": {"const": 75.0}
          }
        }
      }
    },
    "reward_channels_available": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["risk"]}
    }
  }
}
